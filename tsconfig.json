{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "ES2022.Intl"], "types": ["@cloudflare/workers-types", "node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "gateway/**/*.ts", "lab/**/*.ts"]
}
