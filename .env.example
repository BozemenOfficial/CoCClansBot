# For local Wrangler, copy this file to .dev.vars. Never commit .dev.vars.
BOT_TOKEN=replace-with-botfather-token
WEBHOOK_SECRET=replace-with-random-32-byte-hex-string
COC_API_TOKEN=replace-with-clash-developer-key
COC_TRANSPORT=direct
COC_API_BASE_URL=https://api.clashofclans.com/v1
# Only for your own gateway. This is a separate credential, not a Supercell key.
# COC_GATEWAY_TOKEN=
SYNC_BATCH_SIZE=8
# Set this to your deployed Worker app URL in wrangler.toml.
# MINI_APP_URL=https://coc-clans-bot.YOUR-SUBDOMAIN.workers.dev/app/
# Used only by scripts/webhook.mjs, after deploying.
# WEBHOOK_URL=https://coc-clans-bot.YOUR-SUBDOMAIN.workers.dev/webhook
